<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- This edition makes no network requests, so it has no encryption to declare, and App Store
	     Connect stops asking about export compliance on every upload. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<!-- Show in Notch: ilovenotch://show?title=… from scripts and other apps. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>cafe.opennotch.app</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>ilovenotch</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
